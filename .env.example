# Copy to .env.local (never committed) and fill in. Names only here.

# Supabase: Auth and Postgres. Server-only: Reachout has no browser Supabase
# client, so neither is NEXT_PUBLIC_. Locally, `pnpm db:start` prints both
# (API_URL and PUBLISHABLE_KEY). In production, use the project's URL and its
# publishable (or legacy anon) key. No service key is ever needed by the app.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Development only: run as the fictional seed student, in memory, without
# signing in. Changes last until the server restarts. Refused in production.
# REACHOUT_DEV_SEED=true
