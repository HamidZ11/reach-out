# Copy to .env.local (never committed) and fill in. Names only here.
# Everything is server-only: none of these may be NEXT_PUBLIC_.

# Supabase: Auth and Postgres. Locally, `pnpm db:start` prints both
# (API_URL and PUBLISHABLE_KEY). In production, the project's URL (https) and
# its publishable (or legacy anon) key. The app never needs a service key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Rate limits (D-032): 32+ random characters. Required in production;
# development falls back to a fixed value.
REACHOUT_RATE_LIMIT_SECRET=

# Gmail (D-031), optional: leave all four empty and Gmail stays off.
# The redirect URI must be exactly https://<origin>/settings/gmail/callback
# (http://localhost:<port>/... locally) and registered with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=
# 32 random bytes, base64 (openssl rand -base64 32). Seals refresh tokens.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Only while rotating: the previous key, so tokens it sealed still open.
GMAIL_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Development only: run as the fictional seed student, in memory, without
# signing in. Changes last until the server restarts. Refused in production.
# REACHOUT_DEV_SEED=true
